{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>opendefensecloud/renovate-config",
    "github>opendefensecloud/renovate-config:go",
    "github>opendefensecloud/renovate-config:k8s"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "Makefile"
      ],
      "matchStrings": [
        "CERTMANAGER_VERSION := (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cert-manager/cert-manager",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "Makefile"
      ],
      "matchStrings": [
        "TRUSTMANAGER_VERSION := (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cert-manager/trust-manager",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "Makefile"
      ],
      "matchStrings": [
        "ZOT_VERSION := (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/project-zot/helm-charts/zot",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["assets/workflows/*.yaml"],
      "matchStrings": [
        "image:\\s*(?<depName>[a-zA-Z0-9./_-]+):(?<currentValue>[a-zA-Z0-9._-]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "ocm.software/ocm calls fulcio.NewSigner, removed from cosign/v3/cmd/cosign/cli/fulcio in v3.1.2. Unpin once ocm builds against a newer cosign.",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/sigstore/cosign/v3"
      ],
      "allowedVersions": "<=3.1.1"
    },
    {
      "description": "Newer ocm-kit pseudo-versions declare go 1.27.1, which would drag go.mod past the 1.27.0 pinned in Dockerfile and flake.nix. Re-enable once go-overlay is bumped past 2026-09-01 and the toolchain moves to 1.27.1.",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "go.opendefense.cloud/ocm-kit"
      ],
      "enabled": false
    }
  ]
}
