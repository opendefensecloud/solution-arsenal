# A kubeconfig that carries only the agent's token, so the e2e suite can ask the
# apiserver what the agent may do.
# The e2e suite replaces SERVER, CA_DATA and TOKEN.
apiVersion: v1
kind: Config
clusters:
- cluster:
    server: SERVER
    certificate-authority-data: CA_DATA
  name: solar
contexts:
- context:
    cluster: solar
    user: agent
  name: solar
current-context: solar
users:
- name: agent
  user:
    token: TOKEN
