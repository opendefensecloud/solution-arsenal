type: generic.config.ocm.software/v1
configurations:
  - type: credentials.config.ocm.software/v1
    consumers:
      - identity:
          type: OCIRegistry
          hostname: localhost
          # OCM v2 matches a consumer identity on hostname AND port, defaulting
          # an omitted port to 443. This must match the port the demo scripts
          # forward zot to (LOCAL_PORT in test/fixtures/setup-discovery.sh).
          port: "4443"
        credentials:
          - type: Credentials/v1
            properties:
              username: admin
              password: admin
