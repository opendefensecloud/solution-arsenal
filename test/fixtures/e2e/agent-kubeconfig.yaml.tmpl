# The kubeconfig solar-renderer would render for the agent: in-cluster server,
# token read from the file the chart mounts. The e2e suite replaces CA_DATA.
apiVersion: v1
kind: Config
clusters:
- cluster:
    server: https://kubernetes.default.svc
    certificate-authority-data: CA_DATA
  name: solar
contexts:
- context:
    cluster: solar
    user: agent
  name: solar
current-context: solar
users:
- name: agent
  user:
    tokenFile: /etc/solar-agent/token
